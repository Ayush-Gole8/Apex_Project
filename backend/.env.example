# Environment Configuration for Render Deployment

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Secret (Generate a strong secret key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secure_jwt_secret_key_here_make_it_long_and_complex

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (Update with your actual Render frontend URL after deployment)
FRONTEND_URL=https://your-frontend-app.onrender.com

# CORS Origins (comma-separated list - update with your actual Render URLs)
ALLOWED_ORIGINS=https://your-frontend-app.onrender.com,https://your-backend-app.onrender.com

# To get your Gemini API key:
# 1. Go to https://aistudio.google.com/app/apikey (updated URL)
# 2. Sign in with your Google account
# 3. Click "Create API Key"
# 4. Copy the key and paste it here

# For deployment on Render:
# 1. Create a new Web Service for backend
# 2. Add all these environment variables in Render Dashboard
# 3. Update FRONTEND_URL and ALLOWED_ORIGINS with actual URLs
# 4. Deploy!